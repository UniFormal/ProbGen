package info.kwarc.probgen

object HTML {
    def esc(s: String): String =
        s.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;")

    def codeList(xs: Seq[String]): String =
        xs.map(esc).map(s => s"<code>$s</code>").mkString(", ")
}

