% manual definitions for individual stex-generated macros

\newcommand{\ALeA}{ALeA}

% helpers for flexary, optional arguments, etc.
% \fold{sep}{x1,...,xn} = x1 sep ... sep xn
\newcommand{\fold}[2]{\def\@tmpop{\relax}\@for\@I:=#2\do{\@tmpop\@I\def\@tmpop{#1}}}
% \ifnonempty[else]{test}{then}
\newcommand{\ifnonempty}[3][]{\def\@empty{}\def\@test{#2}\ifx\@test\@empty#1\else#3\fi}
% \ifnotbang[else]{test}{then}
\newcommand{\ifnotbang}[3][]{\def\@bang{!}\def\@test{#2}\ifx\@test\@bang#1\else#3\fi}

% \newnullary{a} defines \a as a
\newcommand{\newnullary}[2]{\expandafter\gdef\csname#1\endcsname{#2}}
% \newapplied{fun}{f} defines \fun! for f, \fun{args} for f(args)
\newcommand{\newapplied}[2]{\expandafter\gdef\csname#1\endcsname##1{#2\ifnotbang{##1}{(##1)}}}
% \newindexed{xv}{x} defines \xv! for x, \xv{i} for x_i
\newcommand{\newindexed}[2]{\expandafter\gdef\csname#1\endcsname##1{#2\ifnotbang{##1}{_{##1}}}}
% \newinfix{op}{*} defines \op! for *, \op{x1,...,xn} for x1*...*xn
\newcommand{\newinfix}[2]{\expandafter\newcommand\csname#1\endcsname[2][]{\ifnotbang[#2]{##2}{\fold{#2}{##2}}}}
% \newbinfix{op}{*} defines \op! for *, \op{x1}{x2} for x1*x2
\newcommand{\newbinfix}[2]{\expandafter\newcommand\csname#1\endcsname[3][]{\ifnotbang[#2{##3}]{##2}{##2#2##3}}}

% \newprefix{op}{*} defines \op! for *, \op{x} for *x
\newcommand{\newprefix}[2]{\expandafter\newcommand\csname#1\endcsname[2][]{\ifnotbang[#2]{##2}{##2#2}}}
% \newpostfix{op}{*} defines \op! for *, \op{x} for x*
\newcommand{\newpostfix}[2]{\expandafter\newcommand\csname#1\endcsname[2][]{\ifnotbang[#2]{##2}{#2##2}}}


% \newbinary{op}{pre}{in}{post} defines \op! for pre, \op{x1}{x2} for pre x1 in x2 post
\newcommand{\newbinary}[4]{\expandafter\newcommand\csname#1\endcsname[3][]{\ifnotbang[#1{##1}{##2}{##3}]{##2}{#2##2#3##3#4}}}
\newcommand{\newbinapp}[2]{\newbinary{#1}{#2(}{,}{)}}

